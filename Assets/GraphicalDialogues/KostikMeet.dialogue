      type: {class: 'Constant`1[[System.String, mscorlib]]', ns: Unity.GraphToolkit.Editor, asm: UnityEditor.GraphToolkitModule}
      data:
        m_Value: "\u042F \u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u0442\u044B
          \u0442\u0430\u043A\u043E\u0439 \u0436\u0435 \u0434\u043E\u0431\u0440\u044B\u0439
          *\u0438\u043A*, \u043A\u0430\u043A \u0442\u0432\u043E\u0439 \u043E\u0442\u0435\u0446!
          \u0423 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430 \u043C\u0435\u043D\u044F
          \u043E\u0433\u0440\u0430\u0431\u0438\u043B\u0438. \u042F \u0442\u043E\u043B\u044C\u043A\u043E
          \u043D\u0430 \u043D\u0435\u0433\u043E \u0434\u0435\u043D\u0435\u0433 \u043D\u0430\u0441\u043A\u0440\u0435\u0431,
          \u0430 \u0442\u0443\u0442 \u043D\u0430 \u043C\u0435\u043D\u044F \u0434\u044B\u043B\u0434\u044B
          \u043D\u0430\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u044E\u0442\u0441\u044F.
          \u0411\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u0447\u0435 \u043D\u0435
          \u043F\u043E\u043C\u043D\u044E."
